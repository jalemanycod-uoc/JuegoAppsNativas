<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_game_v3">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#151713"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
        app:titleTextColor="#D0AD27"
        app:popupTheme="@style/ThemeOverlay.AppCompat.Dark" />

    <ScrollView
        android:id="@+id/scrollGame"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="top|center_horizontal"
            android:paddingStart="24dp"
            android:paddingTop="24dp"
            android:paddingEnd="24dp"
            android:paddingBottom="32dp">

            <!-- Máquina más grande y centrada específicamente para tablet -->
            <LinearLayout
                android:layout_width="430dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:padding="18dp"
                android:background="@drawable/cabinet_v3">

                <!-- Cabecera -->
                <LinearLayout
                    android:layout_width="390dp"
                    android:layout_height="82dp"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/cabinet_header_v3"
                    android:padding="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="LOS APKPOCALÍPTICOS"
                        android:textColor="#E2C342"
                        android:textSize="24sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="SLOT MACHINE"
                        android:textColor="#B5AD8A"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <!-- Separador -->
                <View
                    android:layout_width="360dp"
                    android:layout_height="6dp"
                    android:layout_marginTop="10dp"
                    android:background="#D0AD27" />

                <!-- Saldo -->
                <TextView
                    android:id="@+id/tvBalance"
                    android:layout_width="230dp"
                    android:layout_height="54dp"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/display_v3"
                    android:gravity="center"
                    android:text="Saldo: 250"
                    android:textColor="#FFFFFF"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <!-- Rodillos -->
                <LinearLayout
                    android:id="@+id/reelArea"
                    android:layout_width="310dp"
                    android:layout_height="150dp"
                    android:layout_marginTop="18dp"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:padding="10dp"
                    android:background="@drawable/reel_bezel_v3">

                    <com.example.tragaperras.ReelView
                        android:id="@+id/ivReel1"
                        android:layout_width="88dp"
                        android:layout_height="122dp"
                        android:layout_marginHorizontal="5dp"
                        android:background="@drawable/reel_window_v3" />

                    <com.example.tragaperras.ReelView
                        android:id="@+id/ivReel2"
                        android:layout_width="88dp"
                        android:layout_height="122dp"
                        android:layout_marginHorizontal="5dp"
                        android:background="@drawable/reel_window_v3" />

                    <com.example.tragaperras.ReelView
                        android:id="@+id/ivReel3"
                        android:layout_width="88dp"
                        android:layout_height="122dp"
                        android:layout_marginHorizontal="5dp"
                        android:background="@drawable/reel_window_v3" />

                </LinearLayout>

                <!-- Apuesta -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="APUESTA"
                    android:textColor="#B9B199"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <RadioGroup
                    android:id="@+id/rgBets"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:orientation="horizontal"
                    android:gravity="center">

                    <RadioButton
                        android:id="@+id/rbBet10"
                        android:layout_width="82dp"
                        android:layout_height="50dp"
                        android:layout_marginHorizontal="6dp"
                        android:button="@null"
                        android:background="@drawable/bet_v3_selector"
                        android:gravity="center"
                        android:checked="true"
                        android:text="10"
                        android:textColor="#EEE7CE"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <RadioButton
                        android:id="@+id/rbBet25"
                        android:layout_width="82dp"
                        android:layout_height="50dp"
                        android:layout_marginHorizontal="6dp"
                        android:button="@null"
                        android:background="@drawable/bet_v3_selector"
                        android:gravity="center"
                        android:text="25"
                        android:textColor="#EEE7CE"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <RadioButton
                        android:id="@+id/rbBet50"
                        android:layout_width="82dp"
                        android:layout_height="50dp"
                        android:layout_marginHorizontal="6dp"
                        android:button="@null"
                        android:background="@drawable/bet_v3_selector"
                        android:gravity="center"
                        android:text="50"
                        android:textColor="#EEE7CE"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                </RadioGroup>

                <!-- Botón rojo -->
                <FrameLayout
                    android:layout_width="104dp"
                    android:layout_height="104dp"
                    android:layout_marginTop="24dp"
                    android:layout_marginBottom="12dp">

                    <ImageView
                        android:layout_width="84dp"
                        android:layout_height="84dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/button_housing_v1" />

                    <ImageView
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:layout_gravity="center"
                        android:layout_marginTop="10dp"
                        android:contentDescription="@null"
                        android:src="@drawable/push_button_shadow_v1" />

                    <ImageView
                        android:id="@+id/btnMachine"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:layout_gravity="center"
                        android:clickable="true"
                        android:focusable="true"
                        android:contentDescription="Botón de giro"
                        android:src="@drawable/push_button_red_v1" />

                </FrameLayout>

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</LinearLayout>
