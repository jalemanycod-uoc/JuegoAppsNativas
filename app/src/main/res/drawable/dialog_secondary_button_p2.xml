<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#501410" />
            <corners android:radius="9dp" />
            <stroke android:width="2dp" android:color="#A53B33" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#6D211C"
                android:endColor="#35100E" />
            <corners android:radius="9dp" />
            <stroke android:width="2dp" android:color="#9D3932" />
        </shape>
    </item>
</selector>
