<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#060705">

    <!-- Toda la pantalla empieza inmediatamente debajo de la barra de estado.
         Ya NO hay una barra superior vacía ocupando 56dp. -->
    <ScrollView
        android:id="@+id/scrollHome"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:scrollbarStyle="outsideOverlay">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:focusableInTouchMode="true"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="4dp"
            android:paddingBottom="24dp">

            <!-- Logo sin textos incrustados. El título son TextViews. -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="140dp">
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitXY"
                    android:src="@drawable/home_logo_plate_p2"
                    android:contentDescription="@null" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|center_horizontal"
                    android:layout_marginTop="61dp"
                    android:orientation="vertical"
                    android:gravity="center_horizontal">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/home_brand_prefix"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="#FFAC4C" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:maxLines="1"
                        android:autoSizeTextType="uniform"
                        android:autoSizeMinTextSize="15sp"
                        android:autoSizeMaxTextSize="24sp"
                        android:autoSizeStepGranularity="1sp"
                        android:text="@string/home_brand_name"
                        android:shadowColor="#B051FF2A"
                        android:shadowRadius="4"
                        android:textStyle="bold"
                        android:textColor="#BBFF54" />
                </LinearLayout>
            </FrameLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="6dp"
                android:gravity="center"
                android:text="@string/home_welcome"
                android:textColor="#C7FA79"
                android:textStyle="bold"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="13sp"
                android:autoSizeMaxTextSize="18sp"
                android:textSize="18sp"
                android:maxLines="1" />

            <!-- La máscara duplicada se elimina recortando la ilustración.
                 El EditText queda exactamente en la pantalla verde. -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="76dp">
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/home_name_field_v2"
                    android:scaleType="fitXY"
                    android:contentDescription="@null" />
                <EditText
                    android:id="@+id/etName"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_gravity="center_vertical"
                    android:layout_marginStart="86dp"
                    android:layout_marginEnd="49dp"
                    android:paddingStart="2dp"
                    android:paddingEnd="4dp"
                    android:background="@android:color/transparent"
                    android:gravity="center"
                    android:textAlignment="center"
                    android:hint="@string/home_name_hint"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#C0C7B5"
                    android:textSize="17sp"
                    android:inputType="textPersonName|textCapWords"
                    android:imeOptions="actionDone"
                    android:maxLength="20"
                    android:singleLine="true"
                    android:importantForAutofill="yes" />
            </FrameLayout>

            <!-- Error en línea, NO el bocadillo flotante que tapaba el botón. -->
            <TextView
                android:id="@+id/tvNameError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="18dp"
                android:layout_marginEnd="18dp"
                android:paddingStart="8dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:text="@string/home_name_required"
                android:textColor="#FF8175"
                android:textSize="13sp"
                android:visibility="gone" />

            <FrameLayout
                android:id="@+id/btnPlay"
                android:layout_width="match_parent"
                android:layout_height="69dp"
                android:layout_marginTop="4dp"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="@string/home_play"
                android:foreground="?attr/selectableItemBackground">
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitXY"
                    android:src="@drawable/home_play_button_p2"
                    android:contentDescription="@null" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:text="@string/home_play"
                    android:textColor="#F5FFE9"
                    android:textSize="25sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/btnHistory"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginTop="3dp"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="@string/home_history"
                android:foreground="?attr/selectableItemBackground">
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitXY"
                    android:src="@drawable/home_history_button_p2"
                    android:contentDescription="@null" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:text="@string/home_history"
                    android:textColor="#FFF0D2"
                    android:textSize="23sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/home_scores_panel_p2"
                android:orientation="vertical"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingBottom="12dp">
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="68dp">
                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="fitXY"
                        android:src="@drawable/home_scores_header_v2"
                        android:contentDescription="@null" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:maxLines="1"
                        android:autoSizeTextType="uniform"
                        android:autoSizeMinTextSize="13sp"
                        android:autoSizeMaxTextSize="19sp"
                        android:text="@string/home_top_scores"
                        android:textColor="#C6FA65"
                        android:textStyle="bold" />
                </FrameLayout>
                <!-- Las cinco puntuaciones se generan leyendo SQLite. -->
                <LinearLayout
                    android:id="@+id/scoresContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- Solo el menú de tres puntos, flotando encima del logo.
         Mantiene R.id.toolbar y menu_main.xml. -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="top|end"
        android:background="@android:color/transparent"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
        app:titleTextColor="#F9E5B7"
        app:popupTheme="@style/ThemeOverlay.Tragaperras.PopupDark" />
</FrameLayout>
