<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="4dp"
    android:layout_marginEnd="4dp"
    android:layout_marginTop="6dp"
    android:paddingStart="10dp"
    android:paddingTop="9dp"
    android:paddingEnd="10dp"
    android:paddingBottom="9dp"
    android:minHeight="59dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/home_score_row_bg_p2">

    <TextView
        android:id="@+id/tvScoreRank"
        android:layout_width="32dp"
        android:layout_height="38dp"
        android:gravity="center"
        android:text="1"
        android:textColor="#FFD778"
        android:textStyle="bold"
        android:textSize="22sp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="5dp">
        <TextView
            android:id="@+id/tvScorePlayer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#F1E9D1"
            android:textSize="15sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/tvScoreDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#AFAD95"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvScoreCoins"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:gravity="end"
        android:textColor="#F7CA4A"
        android:textSize="14sp"
        android:textStyle="bold" />
</LinearLayout>
