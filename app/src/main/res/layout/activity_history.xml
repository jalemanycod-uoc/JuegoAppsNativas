<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#060705">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingEnd="10dp">

        <!-- Cabecera ilustrada, mismo estilo que la pantalla de inicio. -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="145dp">
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitXY"
                android:src="@drawable/home_logo_plate_p2"
                android:contentDescription="@null" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="top|center_horizontal"
                android:layout_marginTop="74dp"
                android:gravity="center"
                android:text="@string/history_title_p2"
                android:textStyle="bold"
                android:textSize="26sp"
                android:textColor="#C0FF55"
                android:shadowColor="#A86EFF33"
                android:shadowRadius="5" />
        </FrameLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="8dp"
            android:gravity="center"
            android:text="@string/history_subtitle_p2"
            android:textColor="#DFC68C"
            android:textStyle="bold"
            android:textSize="13sp" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@drawable/history_list_bg_p2">
            <ListView
                android:id="@+id/lvHistory"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingStart="5dp"
                android:paddingTop="7dp"
                android:paddingEnd="5dp"
                android:paddingBottom="7dp"
                android:divider="@null"
                android:dividerHeight="0dp"
                android:clipToPadding="false"
                android:scrollbars="vertical" />
            <TextView
                android:id="@+id/tvHistoryEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:padding="16dp"
                android:text="@string/history_empty_p2"
                android:textSize="17sp"
                android:textColor="#D8E4C0"
                android:visibility="gone" />
        </FrameLayout>

        <!-- La primera acción vuelve a la pantalla anterior; la segunda
             regresa al juego existente si venimos del juego. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="8dp"
            android:paddingBottom="12dp">
            <FrameLayout
                android:id="@+id/btnBack"
                android:layout_width="0dp"
                android:layout_height="59dp"
                android:layout_weight="0.9"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="@string/history_back_p2"
                android:foreground="?attr/selectableItemBackground">
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/home_history_button_p2"
                    android:scaleType="fitXY"
                    android:contentDescription="@null" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:text="@string/history_back_p2"
                    android:textColor="#FFE3B1"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </FrameLayout>
            <FrameLayout
                android:id="@+id/btnBackToGame"
                android:layout_width="0dp"
                android:layout_height="59dp"
                android:layout_weight="1.65"
                android:layout_marginStart="4dp"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="@string/history_back_game_p2"
                android:foreground="?attr/selectableItemBackground">
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/home_play_button_p2"
                    android:scaleType="fitXY"
                    android:contentDescription="@null" />
                <TextView
                    android:id="@+id/tvBackToGameLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:text="@string/history_back_game_p2"
                    android:textColor="#F2FFE5"
                    android:textSize="15sp"
                    android:maxLines="1"
                    android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="12sp"
                    android:autoSizeMaxTextSize="16sp"
                    android:textStyle="bold" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Menú de opciones sin franja superior vacía. -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="top|end"
        android:background="@android:color/transparent"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
        app:popupTheme="@style/ThemeOverlay.Tragaperras.PopupDark" />
</FrameLayout>
